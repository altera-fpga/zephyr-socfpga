/* The overlay file should be used to enable any
 * dts nodes required by this application for this
 * board.
 */

&qspi {
	status = "okay";
};

&sdmmc {
	status = "okay";

	mmc {
		/*SD Disk Access */
		compatible = "zephyr,sdmmc-disk";
		disk-name = "SD";
		status = "okay";
	};
};

&timer0 {
	status = "okay";
};

&timer1 {
	status = "okay";
};

&timer2 {
	status = "okay";
};

&timer3 {
	status = "okay";
};

&dma0 {
	status = "okay";
};

&dma1 {
	status = "okay";
};

&sip_smc {
	status = "okay";
	zephyr,num-clients = <5>;
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&i3c0 {
	status = "disabled";

	lps22hh0: lps22hh@FB1122330001 {
		compatible = "st,lps22hh";
		reg = <0x00 0xFB11 0x22330001>;
		odr = <1>;
		status = "disabled";
	};

	lps22hh1: lps22hh@FB1122330002 {
		compatible = "st,lps22hh";
		reg = <0x00 0xFB11 0x22330002>;
		odr = <1>;
		status = "disabled";
	};

	lps22hh2: lps22hh@500000000000000050 { /* i2c device */
		compatible = "st,lps22hh";
		reg = <0x50 0x0 0x50>;
		status = "disabled";
	};
};

&i2c0 {
	status = "okay";
};

&i2c1 {
	status = "okay";
};

&i2c2 {
	status = "okay";
};

&i2c3 {
	status = "okay";
};

&i2c4 {
	status = "okay";
};
